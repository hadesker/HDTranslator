{
    "manifest_version": 3,
    "name": "HD Translator",
    "description": "Translation English - Vietnamese dictionary. Instant translation, online lookup and word translation when you overlay blocks of text",
    "version": "1.3",
    "background": {
        "scripts": ["src/scripts/background.js"]
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "128": "src/assets/icons/128.png"
    },
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_icon": {
            "128": "src/assets/icons/128.png"
        },
        "default_title": "Open HD Translator"
    },
    "sidebar_action": {
        "default_icon": {
            "128": "src/assets/icons/128.png"
        },
        "default_title": "HD Translator",
        "default_panel": "src/pages/sidebar.html",
        "open_at_install": false
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/assets/js/jquery-3.6.0.min.js", "src/scripts/content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["src/scripts/inject.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "hd-translator@dictionary.faster.asia"
        }
    }
}
